# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.

aws_region  = "us-east-1"
environment = "production"

# Networking
vpc_cidr           = "10.0.0.0/16"
az_count           = 2
single_nat_gateway = true # false = one NAT gateway per AZ (HA, ~$32/month more each)

# EKS
cluster_version    = "1.35" # must be 1.34 or newer; 1.34 leaves standard support in Dec 2026
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 4
backend_node_port  = 30080

# Restrict the public Kubernetes API endpoint if you can
# (GitHub-hosted runners need broad access).
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# Extra EKS cluster admins, for example your IAM user:
# eks_admin_principal_arns = ["arn:aws:iam::123456789012:user/your-user"]

# CloudFront
cloudfront_price_class = "PriceClass_100"

# GitHub Actions OIDC roles. Leave github_owner empty to skip them.
github_owner                = "your-github-username"
infra_repository            = "starttech-infra"
app_repository              = "starttech-application"
create_github_oidc_provider = true # false if the account already has the GitHub OIDC provider

# Read-only grader user
create_grader_user = true
